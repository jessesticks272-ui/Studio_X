rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Public, listen-only preview audio. Limit upload type and size.
    match /previews/{userId}/{fileName} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size <= 25 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Full masters remain private to their producer. Future verified
    // purchase delivery must be issued server-side, never via a public URL.
    match /masters/{userId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size <= 250 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Legacy beat uploads may contain publicly accessible full tracks.
    // Keep reads temporarily for existing catalog compatibility, but block
    // new writes. Migrate legacy audio to preview/master paths before launch.
    match /beats/{userId}/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
