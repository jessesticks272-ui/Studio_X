rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email == "jessesticks272@gmail.com";
    }

    // Every signed-in user can maintain only their own account profile.
    // The creator/owner can read the member list for the private dashboard.
    match /users/{userId} {
      allow read: if signedIn()
        && (request.auth.uid == userId || isOwner());

      allow create: if signedIn()
        && request.auth.uid == userId;

      allow update: if signedIn()
        && request.auth.uid == userId;

      allow delete: if signedIn()
        && request.auth.uid == userId;
    }

    // Creator profile: the owner manages the profile; public profile pages
    // need to be able to read creator profiles.
    match /creatorProfiles/{userId} {
      allow read: if signedIn() || true;
      allow create, update, delete: if signedIn()
        && request.auth.uid == userId;
    }

    // Published beats are public. Drafts stay private to their producer
    // and the site owner; query code must filter by status/owner accordingly.
    match /beats/{beatId} {
      allow read: if resource.data.status == "published"
        || (signedIn() && resource.data.ownerId == request.auth.uid)
        || isOwner();

      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid;

      allow update, delete: if signedIn()
        && (resource.data.ownerId == request.auth.uid || isOwner());
    }

    // Feedback is private to its submitter and the site owner.
    // Never trust client-supplied identity; bind ownership to the signed-in UID.
    match /feedback/{feedbackId} {
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 320
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 120
        && request.resource.data.role in ["producer", "artist", "both", "listener"]
        && request.resource.data.area in ["signup", "upload", "explore", "profile", "messages", "mobile", "payments", "other"]
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.details is string
        && request.resource.data.details.size() >= 10
        && request.resource.data.details.size() <= 3000
        && request.resource.data.priority in ["low", "normal", "high"]
        && request.resource.data.status == "new";

      allow read: if signedIn()
        && (resource.data.ownerId == request.auth.uid || isOwner());
      allow update, delete: if isOwner();
    }

    // Messages: only authenticated participants can read or create
    // their own conversations. Message documents cannot be edited/deleted
    // from the client.
    match /messages/{messageId} {
      allow read: if signedIn()
        && request.auth.uid in resource.data.participants;

      allow create: if signedIn()
        && request.resource.data.fromId == request.auth.uid
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.toId in request.resource.data.participants
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000;

      allow update, delete: if false;
    }
  }
}
