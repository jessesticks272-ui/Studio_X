rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email == "jessesticks272@gmail.com";
    }

    function isProducer(uid) {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(uid)).data.role in ["producer", "both"];
    }

    // Account roles are selected during onboarding, but ordinary users can
    // never promote themselves to admin or change their role afterwards.
    match /users/{userId} {
      allow read: if signedIn()
        && (request.auth.uid == userId || isOwner());

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role is string
        && (
          request.resource.data.role in ["artist", "producer", "both", "listener"]
          || (isOwner() && request.resource.data.role == "admin")
        )
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 120
        && request.resource.data.photoURL is string
        && request.resource.data.photoURL.size() <= 2048
        && request.resource.data.keys().hasOnly([
          "uid", "name", "email", "role", "photoURL",
          "createdAt", "updatedAt", "lastLoginAt"
        ]);

      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 120
        && request.resource.data.photoURL is string
        && request.resource.data.photoURL.size() <= 2048
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "name", "email", "photoURL", "updatedAt", "lastLoginAt"
        ]);

      allow delete: if isOwner();
    }

    // Producer profiles are public to read, but only the account owner with
    // the producer role can create or maintain their own storefront.
    match /creatorProfiles/{userId} {
      allow read: if true;
      allow create, update, delete: if signedIn()
        && request.auth.uid == userId
        && isProducer(userId);
    }

    // Published beats are public. Producers own their catalogue records.
    // The owner ID cannot be changed during an update.
    match /beats/{beatId} {
      allow read: if resource.data.status == "published"
        || (signedIn() && resource.data.ownerId == request.auth.uid)
        || isOwner();

      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && (isProducer(request.auth.uid) || isOwner());

      allow update: if signedIn()
        && (
          isOwner()
          || (
            resource.data.ownerId == request.auth.uid
            && request.resource.data.ownerId == resource.data.ownerId
            && isProducer(request.auth.uid)
          )
        );

      allow delete: if signedIn()
        && (
          isOwner()
          || (resource.data.ownerId == request.auth.uid && isProducer(request.auth.uid))
        );
    }

    // Feedback is private to its submitter and the site owner.
    match /feedback/{feedbackId} {
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 320
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 120
        && request.resource.data.role in ["producer", "artist", "both", "listener"]
        && request.resource.data.area in ["signup", "upload", "explore", "profile", "messages", "mobile", "payments", "other"]
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.details is string
        && request.resource.data.details.size() >= 10
        && request.resource.data.details.size() <= 3000
        && request.resource.data.priority in ["low", "normal", "high"]
        && request.resource.data.status == "new";

      allow read: if signedIn()
        && (resource.data.ownerId == request.auth.uid || isOwner());
      allow update, delete: if isOwner();
    }

    // A user can create or remove only their own follow record.
    match /creatorFollows/{followId} {
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.followerUid == request.auth.uid
        && request.resource.data.creatorUid is string
        && request.resource.data.creatorUid != request.auth.uid
        && followId == request.auth.uid + "_" + request.resource.data.creatorUid;

      allow delete: if signedIn()
        && resource.data.followerUid == request.auth.uid;

      allow update: if false;
    }

    // Only the two authenticated participants can access a conversation.
    match /messages/{messageId} {
      allow read: if signedIn()
        && request.auth.uid in resource.data.participants;

      allow create: if signedIn()
        && request.resource.data.fromId == request.auth.uid
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.toId in request.resource.data.participants
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000;

      allow update, delete: if false;
    }

    // Stem jobs are private server-managed records. The API uses Admin SDK
    // access; browser clients cannot forge ownership or read other jobs.
    match /stemJobs/{jobId} {
      allow read, write: if false;
    }

    // Per-account API rate-limit counters are managed only by server code.
    match /apiRateLimits/{rateLimitId} {
      allow read, write: if false;
    }
  }
}
